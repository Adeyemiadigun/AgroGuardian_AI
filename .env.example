# Database
MONGO_URI=mongodb://localhost:27017/agroguardian

# Redis (BullMQ)
# For local dev (recommended):
REDIS_URL=redis://localhost:6379
#
# Upstash example (TLS required):
# REDIS_URL=rediss://:YOUR_PASSWORD@moral-gobbler-95045.upstash.io:6379
# (Alternatively you can set REDIS_URL=moral-gobbler-95045.upstash.io:6379 and provide REDIS_PASSWORD)
#
# Optional split config:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Queue mode:
# - inline: no Redis/BullMQ (best for local dev)
# - redis: use BullMQ + Redis (requires an always-on server process)
QUEUE_MODE=inline
# Force workers on/off (defaults to true when QUEUE_MODE=redis)
# If you deploy a separate Render Background Worker, set RUN_WORKERS=true there and RUN_WORKERS=false on the web service.
# NOTE: both the web process and the worker process run the sweep schedulers,
# so with RUN_WORKERS=true on BOTH, dedup relies on bucketed job ids.
# RUN_WORKERS=true
#
# Redis usage note (Upstash free tier = 500k commands/month):
# The app uses a SINGLE BullMQ queue ("agro-jobs") + ONE worker with a slow
# idle poll (drainDelay 60s), and periodic sweeps run as in-process timers
# (no BullMQ repeatables), keeping idle usage around ~250k commands/month.
# Legacy keys from the old per-queue setup (e.g. "*:repeat*", "*:delayed",
# old queue prefixes like "feeding-reminder-queue*") can be deleted once from
# the Upstash console to free quota after deploying this version.

# Feeding reminders
# Requires QUEUE_MODE=redis + a working REDIS_URL, and RUN_WORKERS=true (or omit RUN_WORKERS).
# Sweep interval options: '15-min', '30-min', 'hourly'
# (Suggest '30-min' if you are tight on the Upstash free-tier quota.)
FEEDING_REMINDER_INTERVAL=15-min

# Reminder matching window in minutes (sends if now is within [scheduled_time, scheduled_time + window))
FEEDING_REMINDER_WINDOW_MINUTES=15

# Vaccination reminders
# Runs a periodic sweep looking at LivestockVaccination.nextDueDate.
# "days ahead" means: send reminder when the due date is within N days.
# Interval options: 'hourly', '6-hourly', 'daily'
VACCINATION_REMINDER_INTERVAL=hourly
VACCINATION_REMINDER_DAYS_AHEAD=0
VACCINATION_REMINDER_WINDOW_HOURS=24
# VACCINATION_REMINDER_DEBUG=true

# Deworming reminders
# Runs a periodic sweep looking at LivestockDeworming.nextDueDate.
# Interval options: 'hourly', '6-hourly', 'daily'
DEWORMING_REMINDER_INTERVAL=hourly
DEWORMING_REMINDER_DAYS_AHEAD=0
DEWORMING_REMINDER_WINDOW_HOURS=24
# DEWORMING_REMINDER_DEBUG=true

# Breeding follow-up reminders
# Interval options: 'hourly', '3-hourly', '6-hourly', 'daily'
# BREEDING_FOLLOWUP_REMINDER_INTERVAL=hourly

# SMS (disabled for now)
# Optional: help normalize local phone numbers (e.g. Nigeria = 234)
# SMS_DEFAULT_COUNTRY_CODE=234

# JWT
JWT_SECRET=your-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here

# External APIs
WEATHER_API_KEY=your-openweather-api-key-here
BREVO_API_KEY=your-brevo-api-key-here

# =============================================================================
# AI Configuration (Groq) - TWO models
# =============================================================================
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Model list: https://console.groq.com/docs/models
#
# 1) VISION MODEL - used for ALL image uploads
#    (crop/livestock diagnoses, practice verification, consultations with photos)
#    Must support image inputs.
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# 2) REASONING MODEL - used for all text-only reasoning/chat
#    (diagnosis chat, vet consultations, health-check analysis)
#    Must NOT need image support. (AI_CHAT_MODEL works as an alias.)
AI_REASONING_MODEL=llama-3.3-70b-versatile
#
# Fallback model(s) if the primary model is unavailable/rate-limited.
# Comma-separated list, highest priority first. Each entry must be Groq-hosted.
AI_FALLBACK_MODELS=meta-llama/llama-4-maverick-17b-128e-instruct,llama-3.1-8b-instant

# Optional: cap tokens to stay within Groq output limits
# AI_MAX_TOKENS=2048
# AI_CHAT_MAX_TOKENS=2048
# AI_VISION_MAX_TOKENS=2048

# Optional: retry settings for transient 429/503
# AI_RETRY_MAX=2
# AI_RETRY_BASE_MS=500

# Optional: when the primary model is rate-limited, skip it briefly and use fallbacks
# AI_PRIMARY_COOLDOWN_MS=30000

# Optional: log token usage
# AI_LOG_LLM_USAGE=true

# Email (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Weather Sync Configuration
# How often to update weather data for all active farms
# Options: 'hourly', '3-hourly', '6-hourly' (recommended), 'daily', 'twice-daily'
WEATHER_SYNC_INTERVAL=6-hourly

# Server
PORT=5000
NODE_ENV=development
